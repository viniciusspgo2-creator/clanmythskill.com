# Produção Next/Vercel: mantenha as credenciais existentes; não use NEXT_PUBLIC_ em segredos.
DATABASE_URL=
# Somente bootstrap da primeira conta: senha exclusiva, 16 a 72 bytes UTF-8.
ADMIN_PASSWORD=
# Chave independente e aleatória para assinar sessões (32+ caracteres recomendados).
ADMIN_SESSION_SECRET=
# E-mail da primeira conta; opcional, padrão admin@mythskill.local.
ADMIN_EMAIL=
# URL definitiva; NEXT_PUBLIC_* é incorporado ao build. Refaça o build ao alterar.
NEXT_PUBLIC_SITE_URL=https://www.clanmythskill.com
# Alternativa LOCAL ao Neon. Não configure no Vercel. Não aponte para o banco de produção.
# MYTHSKILL_LOCAL_DB=.sites-runtime/development.sqlite
# Opcional, somente para consulta A2S direta em runtime com UDP. QGS HTTPS não exige isso.
# ENABLE_A2S=1
