{
  "extends": "./tsconfig.json",
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "scripts/**/*.ts",
    "db/**/*.ts",
    "tests/**/*.ts",
    "cloudflare-env.d.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    ".vinext",
    ".wrangler",
    ".sites-runtime",
    "examples",
    "outputs",
    "work"
  ]
}
